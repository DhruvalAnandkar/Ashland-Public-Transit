# ─── Public Expo env vars ────────────────────────────────────────
# These are embedded into the JS bundle — never put secrets here.
#
# On a physical device or emulator, localhost points at the *device*.
# Use your dev machine's LAN IP instead, e.g. http://192.168.1.42:5000

EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Google Maps / Places key. Required APIs:
#   - Places API (New)
#   - Maps SDK for Android
#   - Maps SDK for iOS
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
