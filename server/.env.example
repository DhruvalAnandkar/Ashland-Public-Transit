# ─── Server configuration ────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/ashland-transit
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/ashland-transit
MONGO_URI=mongodb://localhost:27017/ashland-transit

# ─── Auth ────────────────────────────────────────────────────────
# Use a long, random string in every environment. Do not reuse.
JWT_SECRET=replace-with-a-long-random-string

# ─── Stripe (scaffolded — leave empty unless you've wired billing) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
